NODE_ENV=development
PORT=4000
LOG_LEVEL=info

DATABASE_URL=mongodb://127.0.0.1:27017/best-in-flights-booking

JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false

# Frontend API base URL (read by Vite from this root .env)
# Local: http://localhost:4000  |  Prod: https://endpoint.bestinflights.com
# Leave empty to use Vite proxy to PORT during local same-origin dev
VITE_API_URL=

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password

TRAVINUS_BASE_URL=https://api.travinus.com
TRAVINUS_PARTNER_ID=your-partner-id
TRAVINUS_CLIENT_ID=your-client-id
TRAVINUS_CLIENT_SECRET=your-travinus-client-secret
TRAVINUS_USE_MOCK=true
TRAVINUS_TIMEOUT_MS=30000
